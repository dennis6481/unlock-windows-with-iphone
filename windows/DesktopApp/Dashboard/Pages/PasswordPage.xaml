<Page
    x:Class="UnlockDesktop.PasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Dashboard/Pages/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PasswordExpanderHeaderStyle" TargetType="ToggleButton">
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="HeaderRoot" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" Padding="16"
                                MinHeight="{TemplateBinding MinHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Chevron.Glyph" Value="&#xE70E;"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                <Setter Target="Chevron.Glyph" Value="&#xE70E;"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                <Setter Target="Chevron.Glyph" Value="&#xE70E;"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                                <Setter Target="Chevron.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="HeaderContent" Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                    Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <FontIcon x:Name="Chevron" Grid.Column="1" Glyph="&#xE70D;"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                    Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <ContentControl x:Name="BodyHost" Margin="0,32,0,0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource PageCards}">
            <InfoBar Severity="Success" IsClosable="True" Closed="SuccessClosed"
                     IsOpen="{x:Bind ViewModel.SuccessOpen, Mode=TwoWay}"
                     Visibility="{x:Bind ViewModel.SuccessVisibility, Mode=OneWay}"
                     Title="{x:Bind ViewModel.SuccessTitle, Mode=OneWay}"/>
            <Border Style="{StaticResource SettingsCard}" SizeChanged="AccountCardSizeChanged">
                <Grid x:Name="AccountLayout">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE77B;" Style="{StaticResource CardIcon}"/>
                    <TextBlock x:Name="AccountHeading" Grid.Column="1" Text="Windows account" Style="{StaticResource CardHeading}"/>
                    <TextBlock x:Name="AccountText" Grid.Column="2" VerticalAlignment="Center"
                               Style="{StaticResource CardText}" Text="{x:Bind ViewModel.Account, Mode=OneWay}"/>
                </Grid>
            </Border>
            <Expander x:Name="Management" MinHeight="{StaticResource CardMinHeight}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      IsExpanded="{x:Bind ViewModel.Expanded, Mode=TwoWay}"
                      Loaded="ManagementLoaded" Collapsed="ManagementCollapsed">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72E;" Style="{StaticResource CardIcon}"/>
                        <TextBlock Grid.Column="1" Text="Manage saved password" Style="{StaticResource CardText}" VerticalAlignment="Center"/>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="16" Margin="40,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.PasswordLabel, Mode=OneWay}" Style="{StaticResource CardHeading}"/>
                        <Button Grid.Column="1" Style="{StaticResource PasswordAction}"
                                Content="{x:Bind ViewModel.PasswordAction, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PasswordCommand, Mode=OneWay}"/>
                    </Grid>
                    <Grid Visibility="{x:Bind ViewModel.RemovalVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Remove saved password" Style="{StaticResource CardHeading}"/>
                        <Button Grid.Column="1" Style="{StaticResource PasswordAction}" Content="Remove"
                                IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}">
                            <Button.Flyout>
                                <Flyout x:Name="RemovalFlyout" Placement="TopEdgeAlignedRight">
                                    <StackPanel Spacing="12" MaxWidth="320">
                                        <TextBlock Text="Remove your saved password copy?" FontSize="16" TextWrapping="Wrap"/>
                                        <TextBlock Text="iPhone unlock will be unavailable until you save a password again. Your Microsoft Account password will not change."
                                                   Style="{StaticResource CardText}"/>
                                        <Button Content="Remove saved password" Click="ConfirmRemovalClick"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </StackPanel>
            </Expander>
            <InfoBar x:Name="NoticeBar" Severity="Error" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
                     Message="{x:Bind ViewModel.Notice, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Visibility="{x:Bind ViewModel.RetryVisibility, Mode=OneWay}"
                            Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"/>
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </ContentControl>
</Page>
