<Project DefaultTargets="Test" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="MSBuild\WindowsBuild.props" />
  <PropertyGroup>
    <TestsDirectory>$(MSBuildThisFileDirectory)MSBuild</TestsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <UnlockTestProject Include="$(TestsDirectory)\UnlockSavedCredentialTests.vcxproj" />
    <UnlockTestProject Include="$(TestsDirectory)\UnlockEnrollmentStoreTests.vcxproj" />
    <UnlockTestProject Include="$(TestsDirectory)\UnlockCredentialProviderTests.vcxproj" />
  </ItemGroup>
  <Target Name="BuildTests">
    <MSBuild Projects="@(UnlockTestProject)" Targets="Build" BuildInParallel="false" Properties="Configuration=$(Configuration);Platform=$(Platform);UnlockBuildDirectory=$(UnlockBuildRoot);BuildTesting=ON" />
  </Target>
  <Target Name="Test" DependsOnTargets="BuildTests">
    <Exec Command="&quot;$(UnlockBuildRoot)\unlock_saved_credential_tests.exe&quot;" />
    <Exec Command="&quot;$(UnlockBuildRoot)\unlock_enrollment_store_tests.exe&quot;" />
    <Exec Command="&quot;$(UnlockBuildRoot)\unlock_credential_provider_tests.exe&quot;" />
  </Target>
</Project>
