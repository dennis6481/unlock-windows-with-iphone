<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UnlockBuildDirectory Condition="'$(UnlockBuildDirectory)' == ''">$(MSBuildProjectDirectory)\..\build</UnlockBuildDirectory>
    <UnlockWindowsSdkVersion>$([System.String]::Copy('$(WindowsSDKVersion)').TrimEnd('\'))</UnlockWindowsSdkVersion>
    <UnlockBuildResourcesImported>true</UnlockBuildResourcesImported>
  </PropertyGroup>
  <Import Project="$(UnlockBuildDirectory)\generated\UnlockBuild.props" Condition="Exists('$(UnlockBuildDirectory)\generated\UnlockBuild.props')" />
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A952BE06-DB40-4984-B6B1-7C8907D74E6A}</ProjectGuid>
    <ProjectName>UnlockDesktop</ProjectName>
    <RootNamespace>UnlockDesktop</RootNamespace>
    <WindowsTargetPlatformVersion>$(UnlockWindowsSdkVersion)</WindowsTargetPlatformVersion>
    <TargetPlatformVersion>$(WindowsTargetPlatformVersion)</TargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.$(UnlockMinimumWindowsBuild).0</WindowsTargetPlatformMinVersion>
    <AppContainerApplication>false</AppContainerApplication>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <DisableWindowsAppSDKMLAutoInitialize>true</DisableWindowsAppSDKMLAutoInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <RuntimeIdentifiers>win10-$(UnlockArchitecture)</RuntimeIdentifiers>
    <NuGetTargetMoniker>native,Version=v0.0</NuGetTargetMoniker>
    <NuGetTargetPlatformIdentifier>Windows</NuGetTargetPlatformIdentifier>
    <NuGetTargetPlatformVersion>$(WindowsTargetPlatformVersion)</NuGetTargetPlatformVersion>
    <RestorePackagesPath>$(MSBuildProjectDirectory)\packages</RestorePackagesPath>
    <BaseIntermediateOutputPath>$(UnlockBuildDirectory)\obj\$(Platform)\$(Configuration)\$(ProjectName)\</BaseIntermediateOutputPath>
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTPath>"$([System.String]::Copy('$(WindowsSdkDir)').TrimEnd('\'))\bin\$(UnlockWindowsSdkVersion)\x64/"</CppWinRTPath>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64"><Configuration>Debug</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="2.0.240405.15" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <DesktopCompatible>true</DesktopCompatible>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="..\UnlockNative.props" />
  <PropertyGroup>
    <TargetName>$(UnlockMainAppBaseName)</TargetName>
    <OutDir>$(UnlockBuildDirectory)\</OutDir>
    <IntDir>$(UnlockBuildDirectory)\obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <GeneratedFilesDir>$(IntDir)Generated Files\</GeneratedFilesDir>
    <XamlGeneratedOutputPath>$(IntDir)Generated Xaml\</XamlGeneratedOutputPath>
    <GenerateManifest>true</GenerateManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PrecompiledHeaderFile />
      <LanguageStandard>stdcpp20</LanguageStandard>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <ProgramDataBaseFileName>$(IntDir)$(ProjectName).pdb</ProgramDataBaseFileName>
      <AdditionalOptions>/utf-8 /bigobj %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(GeneratedFilesDir)Dashboard\Pages;..;..\DesktopApp\Dashboard\Pages;..\Protocol;..\PhoneApproval;..\SavedCredential;..\GattHost;Dashboard\Pages;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>$(UnlockBuildDirectory)\unlock_desktop_native.lib;$(UnlockBuildDirectory)\unlock_saved_credential_ipc.lib;$(UnlockBuildDirectory)\unlock_enrollment_store.lib;$(UnlockBuildDirectory)\unlock_protocol_crypto.lib;windowsapp.lib;user32.lib;shell32.lib;wtsapi32.lib;ole32.lib;advapi32.lib;comctl32.lib;gdi32.lib;bcrypt.lib;crypt32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile><PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile><PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="..\MSBuild\UnlockDesktopNative.vcxproj">
      <Project>{8F9E1E4D-FD09-4C16-80A4-0E9E1B9C157B}</Project>
      <LinkLibraryDependencies>true</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="./main.cpp" />
    <ClCompile Include="./DesktopHost.cpp" />
    <ClCompile Include="./DesktopNotifications.cpp" />
    <ClCompile Include="..\Enrollment/Enrollment.cpp" />
    <ClCompile Include="..\SavedCredential/CredentialManagement.cpp" />
    <ClInclude Include="./DesktopApplication.h" />
    <ClCompile Include="./Dashboard/Dashboard.cpp" />
    <ClCompile Include="Dashboard\Pages/StatusPage.xaml.cpp" />
    <ClCompile Include="Dashboard\Pages/PasswordPage.xaml.cpp" />
    <ClCompile Include="Dashboard\Pages/DiagnosticsPage.xaml.cpp" />
    <ClCompile Include="Dashboard\Pages/AboutPage.xaml.cpp" />
    <ClInclude Include="Dashboard\Pages\StatusPage.xaml.h"><DependentUpon>StatusPage.xaml</DependentUpon></ClInclude>
    <ClInclude Include="Dashboard\Pages\PasswordPage.xaml.h"><DependentUpon>PasswordPage.xaml</DependentUpon></ClInclude>
    <ClInclude Include="Dashboard\Pages\DiagnosticsPage.xaml.h"><DependentUpon>DiagnosticsPage.xaml</DependentUpon></ClInclude>
    <ClInclude Include="Dashboard\Pages\AboutPage.xaml.h"><DependentUpon>AboutPage.xaml</DependentUpon></ClInclude>
    <Midl Include="Dashboard\Pages\DashboardPages.idl" />
    <Page Include="Dashboard\Pages\StatusPage.xaml" />
    <Page Include="Dashboard\Pages\PasswordPage.xaml" />
    <Page Include="Dashboard\Pages\DiagnosticsPage.xaml" />
    <Page Include="Dashboard\Pages\AboutPage.xaml" />
    <ResourceCompile Include="$(UnlockGeneratedDirectory)\UnlockWithIPhone-version.rc" />
    <ResourceCompile Include="..\Resources\AppIcon.rc" />
    <Manifest Include="..\Resources/DesktopUi.manifest" />
  </ItemGroup>
  <Import Project="HybridCRT.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="WriteDesktopFileList" AfterTargets="Build">
    <ItemGroup>
      <DesktopFile Include="$(TargetFileName);$(TargetName).pri" />
      <DesktopXamlFile Include="@(ProcessedXamlFiles)">
        <RelativePath>$([MSBuild]::MakeRelative('$(OutDir)', '%(ProcessedXamlFiles.FullPath)'))</RelativePath>
      </DesktopXamlFile>
      <DesktopFile Include="@(DesktopXamlFile->'%(RelativePath)')" />
      <DesktopFile Include="@(MicrosoftWindowsAppSDKFiles->'%(RecursiveDir)%(Filename)%(Extension)')" />
      <DesktopFile Include="@(ReferenceCopyLocalPaths->'%(DestinationSubDirectory)%(Filename)%(Extension)')" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(DesktopFile)">
      <Output TaskParameter="Filtered" ItemName="DesktopFileUnique" />
    </RemoveDuplicates>
    <WriteLinesToFile File="$(OutDir)DesktopApp.files" Lines="@(DesktopFileUnique)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>
</Project>
