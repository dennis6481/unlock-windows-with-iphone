<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?include $(var.GeneratedDirectory)\Product.wxi ?>
  <Package Name="$(var.ProductName)" Manufacturer="Rui MA" Version="$(var.MsiVersion)"
           UpgradeCode="$(var.UpgradeCode)" Scope="perMachine" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade AllowSameVersionUpgrades="yes" MigrateFeatures="no" Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="BuildNumberSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILDNUMBER &gt;= $(var.MinimumWindowsBuild))"
            Message="$(var.ProductName) requires 64-bit Windows 10 build $(var.MinimumWindowsBuild) or later. Please update Windows and try again." />
    <Launch Condition="NOT RollbackDisabled" Message="This package requires Windows Installer rollback to be enabled." />
    <Property Id="FullProductVersion" Value="$(var.FullVersion)" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />
    <Property Id="MSIDISABLERMRESTART" Value="1" />
    <Property Id="TARGETSID" Secure="yes" Hidden="yes" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[DesktopDirectory]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="WixUnelevatedShellExecTarget" Value="[DesktopDirectory]$(var.MainAppFile)" After="CostFinalize" Sequence="ui" />
    <UI>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="ARPNOMODIFY" Value="1" />
      <UIRef Id="WixUI_Common" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="EndDialog" Value="Return" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Order="1"
               Condition="WixUnelevatedShellExecTarget AND (NOT Installed OR WixUI_InstallMode=&quot;Repair&quot;)" />
    </UI>
    <Feature Id="Product" Title="$(var.ProductName)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProductPayload" />
      <ComponentRef Id="MachineIdentity" />
    </Feature>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="DesktopDirectory" Name="$(var.DesktopDirectoryName)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <DirectoryRef Id="DesktopDirectory">
      <Component Id="MachineIdentity" Guid="*" Bitness="always64">
        <RemoveFolder Id="RemoveDesktopDirectory" On="uninstall" />
        <RegistryKey Root="HKLM" Key="$(var.InstalledProductRegistryPath)" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="$(var.TargetSidValueName)" Value="[TARGETSID]" Type="string" KeyPath="yes" />
          <RegistryValue Name="$(var.InstalledVersionValueName)" Value="$(var.FullVersion)" Type="string" />
          <RegistryValue Name="$(var.DeploymentKindValueName)" Value="MSI" Type="string" />
          <RegistryValue Name="$(var.MsiProductCodeValueName)" Value="[ProductCode]" Type="string" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
    <Icon Id="AppIcon.exe" SourceFile="$(var.MainAppSource)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Binary Id="NativeActions" SourceFile="$(var.ActionsPath)" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixUnelevatedShellExec" Execute="immediate" Return="check" />
    <CustomAction Id="ConfigureApplicationLaunch" BinaryRef="NativeActions" DllEntry="ConfigureApplicationLaunch" Execute="immediate" Return="check" />
    <CustomAction Id="CheckExeInstallation" BinaryRef="NativeActions" DllEntry="CheckExeInstallation" Execute="immediate" Return="check" />
    <CustomAction Id="ValidateDeployment" BinaryRef="NativeActions" DllEntry="ValidateDeployment" Execute="immediate" Return="check" />
    <CustomAction Id="CloseApplication" BinaryRef="NativeActions" DllEntry="CloseApplication" Execute="immediate" Return="check" />
    <CustomAction Id="InitializeDeployment" BinaryRef="NativeActions" DllEntry="InitializeDeployment" Execute="immediate" Return="check" />
    <CustomAction Id="PrepareDeployment" BinaryRef="NativeActions" DllEntry="PrepareDeployment" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="RollbackDeployment" BinaryRef="NativeActions" DllEntry="RollbackDeployment" Execute="rollback" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="RemoveProductData" BinaryRef="NativeActions" DllEntry="RemoveProductData" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="CaptureRebootState" BinaryRef="NativeActions" DllEntry="CaptureRebootState" Execute="immediate" Return="check" />
    <CustomAction Id="CompleteDeployment" BinaryRef="NativeActions" DllEntry="CompleteDeployment" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="CommitDeployment" BinaryRef="NativeActions" DllEntry="CommitDeployment" Execute="commit" Impersonate="no" Return="check" HideTarget="yes" />
    <InstallUISequence>
      <MigrateFeatureStates Suppress="yes" />
      <Custom Action="CheckExeInstallation" After="LaunchConditions" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ConfigureApplicationLaunch" After="ExecuteAction" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <MigrateFeatureStates Suppress="yes" />
      <Custom Action="CheckExeInstallation" After="LaunchConditions" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ValidateDeployment" Before="CloseApplication" />
      <Custom Action="CloseApplication" Before="InstallValidate" Condition="UILevel &gt;= 4 AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="InitializeDeployment" After="InstallValidate" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackDeployment" After="InstallInitialize" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PrepareDeployment" After="RollbackDeployment" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveProductData" After="StopServices" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <!-- Flush file operations during repair/uninstall too, before capturing MSI reboot state. -->
      <InstallExecute Sequence="6500" Condition="1" />
      <!-- Keep service startup after the afterInstallExecute upgrade removal and before InstallFinalize (6600). -->
      <StartServices Sequence="6551" />
      <Custom Action="CaptureRebootState" After="StartServices" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="CompleteDeployment" After="CaptureRebootState" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CommitDeployment" Before="InstallFinalize" Condition="NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
