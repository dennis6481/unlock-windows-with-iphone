<Project DefaultTargets="Test" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UnlockBuildDirectory Condition="'$(UnlockBuildDirectory)' == ''">$(MSBuildThisFileDirectory)build</UnlockBuildDirectory>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <TestsDirectory>$(MSBuildThisFileDirectory)MSBuild</TestsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <UnlockTestProject Include="$(TestsDirectory)\UnlockSavedCredentialTests.vcxproj" />
    <UnlockTestProject Include="$(TestsDirectory)\UnlockProtocolTests.vcxproj" />
    <UnlockTestProject Include="$(TestsDirectory)\UnlockPhoneApprovalTests.vcxproj" />
    <UnlockTestProject Include="$(TestsDirectory)\UnlockEnrollmentStoreTests.vcxproj" />
    <UnlockTestProject Include="$(TestsDirectory)\UnlockSetupTests.vcxproj" />
    <UnlockTestProject Include="$(TestsDirectory)\UnlockCredentialProviderTests.vcxproj" />
  </ItemGroup>
  <Target Name="BuildTests">
    <MSBuild Projects="@(UnlockTestProject)" Targets="Build" BuildInParallel="false" Properties="Configuration=$(Configuration);Platform=$(Platform);UnlockBuildDirectory=$(UnlockBuildDirectory);BuildTesting=ON" />
  </Target>
  <Target Name="Test" DependsOnTargets="BuildTests">
    <Exec Command="&quot;$(UnlockBuildDirectory)\unlock_saved_credential_tests.exe&quot;" />
    <Exec Command="&quot;$(UnlockBuildDirectory)\unlock_protocol_tests.exe&quot;" />
    <Exec Command="&quot;$(UnlockBuildDirectory)\unlock_phone_approval_tests.exe&quot;" />
    <Exec Command="&quot;$(UnlockBuildDirectory)\unlock_enrollment_store_tests.exe&quot;" />
    <Exec Command="&quot;$(UnlockBuildDirectory)\unlock_setup_tests.exe&quot;" />
    <Exec Command="&quot;$(UnlockBuildDirectory)\unlock_credential_provider_tests.exe&quot;" />
  </Target>
</Project>
