<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectGuid>{1EBD0A80-803E-4A5E-9D15-7F4495D95845}</ProjectGuid>
    <ProjectName>UnlockWindowsSetup</ProjectName>
    <RootNamespace>UnlockWindowsSetup</RootNamespace>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64"><Configuration>Debug</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(MSBuildThisFileDirectory)..\UnlockNative.props" />
  <PropertyGroup>
    <TargetName>$(UnlockInstallerBaseName)</TargetName>
    <OutDir>$(UnlockBuildDirectory)\</OutDir>
    <IntDir>$(UnlockBuildDirectory)\obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>..\Msi;..\SavedCredential;..;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp20</LanguageStandard>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>msi.lib;userenv.lib;advapi32.lib;ole32.lib;shell32.lib;uuid.lib;wtsapi32.lib;user32.lib;windowsapp.lib;$(UnlockLibraryDirectory)\unlock_saved_credential_ipc.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalOptions>/MANIFEST:NO %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\Msi\CustomActions.cpp" />
    <ClCompile Include="..\Msi\UserIntegration.cpp" />
    <ResourceCompile Include="$(UnlockGeneratedDirectory)\$(UnlockInstallerBaseName)-version.rc" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="UnlockSavedCredentialIpc.vcxproj">
      <Project>{8CBDEB42-8B4B-4F2B-9D52-0BF1A9824D02}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ProjectReference Include="UnlockSavedCredentialService.vcxproj">
      <Project>{7B2692DD-A3CD-4311-8E33-7D10B22D3B2E}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ProjectReference Include="UnlockCredentialProvider.vcxproj">
      <Project>{0CD8485B-190B-4B1C-BB16-0DB1B7B31B10}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ProjectReference Include="..\DesktopApp\DesktopApp.vcxproj">
      <Project>{A952BE06-DB40-4984-B6B1-7C8907D74E6A}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="BuildMsi" AfterTargets="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\Msi\Build.ps1&quot; -Generate -BuildDirectory &quot;$(UnlockBuildDirectory)&quot; -Architecture &quot;$(UnlockArchitecture)&quot;" />
    <!-- /restore reevaluates the project after NuGet writes the extension imports. -->
    <Exec Command="&quot;$(MSBuildBinPath)\MSBuild.exe&quot; &quot;$(MSBuildThisFileDirectory)..\Msi\UnlockWindows.wixproj&quot; /restore /nologo &quot;/p:Configuration=$(Configuration)&quot; &quot;/p:Platform=$(Platform)&quot; &quot;/p:UnlockBuildDirectory=$(UnlockBuildDirectory)&quot;" StdOutEncoding="UTF-8" StdErrEncoding="UTF-8" />
  </Target>
</Project>
