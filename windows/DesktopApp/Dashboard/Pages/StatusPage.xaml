<Page
    x:Class="UnlockDesktop.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UnlockDesktop"
    NavigationCacheMode="Required">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Dashboard/Pages/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <ContentControl x:Name="BodyHost" Margin="0,32,0,0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource PageCards}">
            <InfoBar Severity="Success" IsClosable="True" Margin="0,0,0,20" Closed="SuccessClosed"
                     IsOpen="{x:Bind ViewModel.SuccessOpen, Mode=TwoWay}"
                     Visibility="{x:Bind ViewModel.SuccessVisibility, Mode=OneWay}"
                     Title="iPhone bound successfully"
                     Message="Lock this PC and click Unlock on the Windows sign-in screen to try it."/>
            <StackPanel Spacing="12" Margin="0,0,0,9">
                <FontIcon Glyph="&#xE8EA;" FontSize="100" HorizontalAlignment="Center"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" AutomationProperties.Name="iPhone"/>
                <TextBlock Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" FontSize="24" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <Border Style="{StaticResource SettingsCard}" Visibility="{x:Bind ViewModel.BoundVisibility, Mode=OneWay}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE823;" Style="{StaticResource CardIcon}"/>
                    <TextBlock Grid.Column="1" Text="Last Unlock" Style="{StaticResource CardHeading}"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="14" TextWrapping="NoWrap" TextAlignment="Right"
                               Text="{x:Bind ViewModel.LastUnlock, Mode=OneWay}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Visibility="{x:Bind ViewModel.BoundVisibility, Mode=OneWay}"
                    SizeChanged="ThresholdCardSizeChanged">
                <Grid x:Name="ThresholdLayout">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <FontIcon x:Name="RangeIcon" Style="{StaticResource CardIcon}"/>
                    <StackPanel x:Name="ThresholdHeading" Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Unlock range" Style="{StaticResource CardText}"/>
                        <TextBlock Text="RSSI-based range does not indicate an exact distance." FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Grid x:Name="ThresholdControls" Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="NearLabel" Style="{StaticResource CardText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider x:Name="Threshold" Grid.Column="1" Width="240" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Value="{x:Bind ViewModel.RangeValue, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.ManagementEnabled, Mode=OneWay}"
                                SnapsTo="Ticks" TickPlacement="Outside" AutomationProperties.Name="Unlock range: Near, Medium, Far"/>
                        <TextBlock x:Name="FarLabel" Grid.Column="2" Style="{StaticResource CardText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Visibility="{x:Bind ViewModel.BoundVisibility, Mode=OneWay}"
                    SizeChanged="RemovalCardSizeChanged">
                <Grid x:Name="RemovalLayout">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <FontIcon x:Name="RemovalIcon" Style="{StaticResource CardIcon}"/>
                    <TextBlock x:Name="RemovalHeading" Grid.Column="1" Text="Remove bound iPhone" Style="{StaticResource CardHeading}"/>
                    <Button x:Name="RemoveButton" Grid.Column="2" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Right"
                            IsEnabled="{x:Bind ViewModel.ManagementEnabled, Mode=OneWay}">
                        <Button.Flyout>
                            <Flyout x:Name="RemovalFlyout" Placement="TopEdgeAlignedRight">
                                <StackPanel Spacing="12" MaxWidth="320">
                                    <TextBlock Text="Remove this iPhone binding?" FontSize="16" TextWrapping="Wrap"/>
                                    <TextBlock Text="Your iPhone will remain paired in Windows Bluetooth settings." Style="{StaticResource CardText}"/>
                                    <Button Content="Remove binding" Click="ConfirmRemovalClick"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
            <ContentControl HorizontalContentAlignment="Stretch" Visibility="{x:Bind ViewModel.BindingVisibility, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.BindingEnabled, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="iPhone not listed?"
                             Message="If your iPhone isn't listed below, pair it in Windows Bluetooth settings.">
                        <InfoBar.ActionButton>
                            <Button Content="Open Bluetooth settings" Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneWay}"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <TextBlock Text="Paired BLE devices" FontSize="16" TextWrapping="Wrap"/>
                    <ListView x:Name="DevicesList" SelectionMode="Single" ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.DevicesEnabled, Mode=OneWay}"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" AutomationProperties.Name="BLE devices paired in Windows">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="12"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PairedDevice">
                            <TextBlock Text="{x:Bind Name, Mode=OneTime}" FontSize="16" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="No paired BLE devices found. Pair your iPhone in Windows Bluetooth settings, then return here."
                               TextWrapping="Wrap" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"/>
                    <Button x:Name="BindButton" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.BindCommand, Mode=OneWay}" Loaded="BindButtonLoaded"
                            AutomationProperties.Name="{x:Bind ViewModel.BindAutomationName, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="20" Height="20" VerticalAlignment="Center" IsIndeterminate="True"
                                          Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}"
                                          IsActive="{x:Bind ViewModel.BindingBusy, Mode=OneWay}"/>
                            <TextBlock x:Name="BindText" Text="{x:Bind ViewModel.BindLabel, Mode=OneWay}" FontSize="14"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.BindingMessage, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>
            </ContentControl>
            <InfoBar Severity="Error" IsClosable="False" Title="Status needs attention"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsOpen="{x:Bind ViewModel.ErrorOpen, Mode=OneWay}"/>
        </StackPanel>
    </ContentControl>
</Page>
