<!-- Created by Rui MA on 09 Oct 2026 -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A952BE06-DB40-4984-B6B1-7C8907D74E6A}</ProjectGuid>
    <ProjectName>UnlockDesktop</ProjectName>
    <RootNamespace>UnlockDesktop</RootNamespace>
    <WindowsTargetPlatformVersion>@UNLOCK_DESKTOP_SDK@</WindowsTargetPlatformVersion>
    <TargetPlatformVersion>$(WindowsTargetPlatformVersion)</TargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.@UNLOCK_MINIMUM_WINDOWS_BUILD@.0</WindowsTargetPlatformMinVersion>
    <AppContainerApplication>false</AppContainerApplication>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <DisableWindowsAppSDKMLAutoInitialize>true</DisableWindowsAppSDKMLAutoInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <RuntimeIdentifiers>win10-@UNLOCK_SETUP_ARCHITECTURE@</RuntimeIdentifiers>
    <NuGetTargetMoniker>native,Version=v0.0</NuGetTargetMoniker>
    <NuGetTargetPlatformIdentifier>Windows</NuGetTargetPlatformIdentifier>
    <NuGetTargetPlatformVersion>$(WindowsTargetPlatformVersion)</NuGetTargetPlatformVersion>
    <RestorePackagesPath>$(MSBuildProjectDirectory)\packages</RestorePackagesPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\</BaseIntermediateOutputPath>
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTPath>"@UNLOCK_DESKTOP_CPPWINRT_DIRECTORY@/"</CppWinRTPath>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64"><Configuration>Debug</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="2.0.240405.15" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <DesktopCompatible>true</DesktopCompatible>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>@UNLOCK_DESKTOP_NAME@</TargetName>
    <OutDir>@UNLOCK_DESKTOP_DIRECTORY@\</OutDir>
    <IntDir>$(BaseIntermediateOutputPath)$(Platform)\$(Configuration)\</IntDir>
    <GenerateManifest>true</GenerateManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PrecompiledHeaderFile />
      <LanguageStandard>@UNLOCK_DESKTOP_CPP_STANDARD@</LanguageStandard>
      <AdditionalOptions>@UNLOCK_DESKTOP_OPTIONS@ /bigobj %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>@UNLOCK_DESKTOP_INCLUDES@;@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>@UNLOCK_DESKTOP_DEFINITIONS@;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>@UNLOCK_DESKTOP_DEFINITIONS@;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>@UNLOCK_DESKTOP_LIBRARIES@;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile><PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile><PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/main.cpp" />
    <ClCompile Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/DesktopHost.cpp" />
    <ClCompile Include="@CMAKE_CURRENT_SOURCE_DIR@/SavedCredential/CredentialManagement.cpp" />
    <ClInclude Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/DesktopApplication.h" />
    <ClCompile Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Dashboard.cpp" />
    <ClCompile Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/StatusPage.xaml.cpp" />
    <ClCompile Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/PasswordPage.xaml.cpp" />
    <ClCompile Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/DiagnosticsPage.xaml.cpp" />
    <ClCompile Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/AboutPage.xaml.cpp" />
    <ClInclude Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/StatusPage.xaml.h"><DependentUpon>StatusPage.xaml</DependentUpon></ClInclude>
    <ClInclude Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/PasswordPage.xaml.h"><DependentUpon>PasswordPage.xaml</DependentUpon></ClInclude>
    <ClInclude Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/DiagnosticsPage.xaml.h"><DependentUpon>DiagnosticsPage.xaml</DependentUpon></ClInclude>
    <ClInclude Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/AboutPage.xaml.h"><DependentUpon>AboutPage.xaml</DependentUpon></ClInclude>
    <Midl Include="$([MSBuild]::NormalizePath('@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/DashboardPages.idl'))" />
    <Page Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/StatusPage.xaml"><Link>StatusPage.xaml</Link></Page>
    <Page Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/PasswordPage.xaml"><Link>PasswordPage.xaml</Link></Page>
    <Page Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/DiagnosticsPage.xaml"><Link>DiagnosticsPage.xaml</Link></Page>
    <Page Include="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/Dashboard/Pages/AboutPage.xaml"><Link>AboutPage.xaml</Link></Page>
    <ResourceCompile Include="@UNLOCK_DESKTOP_VERSION_RESOURCE@" />
    <ResourceCompile Include="@CMAKE_CURRENT_BINARY_DIR@/DesktopUi.rc" />
    <ResourceCompile Include="@CMAKE_CURRENT_BINARY_DIR@/AppIcon.rc" />
    <Manifest Include="@CMAKE_CURRENT_SOURCE_DIR@/Resources/DesktopUi.manifest" />
  </ItemGroup>
  <Import Project="@CMAKE_CURRENT_SOURCE_DIR@/DesktopApp/HybridCRT.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="WriteDesktopFileList" AfterTargets="Build">
    <ItemGroup>
      <DesktopFile Include="$(TargetFileName);$(TargetName).pri" />
      <DesktopFile Include="@(GeneratedXamlDest->'%(Filename)%(Extension)')" />
      <DesktopFile Include="@(MicrosoftWindowsAppSDKFiles->'%(RecursiveDir)%(Filename)%(Extension)')" />
      <DesktopFile Include="@(ReferenceCopyLocalPaths->'%(DestinationSubDirectory)%(Filename)%(Extension)')" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(DesktopFile)">
      <Output TaskParameter="Filtered" ItemName="DesktopFileUnique" />
    </RemoveDuplicates>
    <WriteLinesToFile File="$(OutDir)DesktopApp.files" Lines="@(DesktopFileUnique)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>
</Project>
