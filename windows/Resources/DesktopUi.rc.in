#include <windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/Resources/resource.h"


#ifdef UNLOCK_UI_PAIRING
IDD_PHONE_PAIRING DIALOGEX 0, 0, 360, 258
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Pair iPhone"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "Pair your iPhone", IDC_UI_TITLE, 14, 12, 332, 24, SS_NOPREFIX
    EDITTEXT IDC_UI_ACCOUNT, 14, 43, 332, 28, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "", IDC_UI_MESSAGE, 14, 80, 332, 42, SS_NOPREFIX
    EDITTEXT IDC_UI_FINGERPRINT, 14, 130, 332, 37, ES_MULTILINE | ES_READONLY | WS_TABSTOP, WS_EX_CLIENTEDGE
    LTEXT "", IDC_UI_NOTICE, 14, 177, 332, 36, SS_NOPREFIX
    DEFPUSHBUTTON "Pair iPhone", IDOK, 204, 227, 72, 16
    PUSHBUTTON "Cancel", IDCANCEL, 284, 227, 62, 16
END
#endif

#ifdef UNLOCK_UI_SAVED_PASSWORD
IDD_SAVED_PASSWORD DIALOGEX 0, 0, 388, 292
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Saved Windows password"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "Saved Windows password", IDC_UI_TITLE, 14, 12, 360, 24, SS_NOPREFIX
    EDITTEXT IDC_UI_ACCOUNT, 14, 43, 360, 28, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Loading account information...", IDC_UI_MESSAGE, 14, 80, 360, 51, SS_NOPREFIX
    PUSHBUTTON "Save password...", IDC_UI_SAVE, 14, 139, 100, 16
    PUSHBUTTON "Update saved password...", IDC_UI_UPDATE, 122, 139, 122, 16
    PUSHBUTTON "Remove saved password...", IDC_UI_REMOVE, 252, 139, 122, 16
    AUTOCHECKBOX "Technical details", IDC_UI_TECHNICAL_TOGGLE, 14, 170, 140, 16
    EDITTEXT IDC_UI_TECHNICAL, 14, 190, 360, 54, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, WS_EX_CLIENTEDGE
    PUSHBUTTON "Refresh", IDC_UI_REFRESH, 226, 261, 70, 16
    DEFPUSHBUTTON "Close", IDCANCEL, 304, 261, 70, 16
END
#endif
