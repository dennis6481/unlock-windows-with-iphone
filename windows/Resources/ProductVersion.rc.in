#include <windows.h>

1 VERSIONINFO
FILEVERSION @UNLOCK_VERSION_MAJOR@,@UNLOCK_VERSION_MINOR@,@UNLOCK_VERSION_PATCH@,0
PRODUCTVERSION @UNLOCK_VERSION_MAJOR@,@UNLOCK_VERSION_MINOR@,@UNLOCK_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE @UNLOCK_VERSION_FILE_TYPE@
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Rui MA\0"
            VALUE "FileDescription", "Unlock Windows with iPhone\0"
            VALUE "FileVersion", "@UNLOCK_VERSION_TEXT@\0"
            VALUE "ProductVersion", "@UNLOCK_VERSION_TEXT@\0"
            VALUE "ProductName", "Unlock Windows with iPhone\0"
            VALUE "OriginalFilename", "@UNLOCK_VERSION_FILENAME@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
