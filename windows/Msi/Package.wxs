<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?include $(var.GeneratedDirectory)\Product.wxi ?>
  <Package Name="$(var.ProductName)" Manufacturer="Rui MA" Version="$(var.MsiVersion)"
           UpgradeCode="$(var.UpgradeCode)" Scope="perMachine" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Launch Condition="Installed OR (VersionNT64 AND WindowsBuild &gt;= $(var.MinimumWindowsBuild))"
            Message="This package requires the supported native 64-bit Windows version." />
    <Launch Condition="NOT RollbackDisabled" Message="This package requires Windows Installer rollback to be enabled." />
    <Property Id="FullProductVersion" Value="$(var.FullVersion)" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />
    <Property Id="MSIDISABLERMRESTART" Value="1" />
    <Property Id="TARGETSID" Secure="yes" Hidden="yes" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[DesktopDirectory]" After="CostFinalize" Sequence="execute" />
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.GeneratedDirectory)\License.rtf" />
    <Feature Id="Product" Title="$(var.ProductName)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProductPayload" />
      <ComponentRef Id="MachineIdentity" />
    </Feature>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="DesktopDirectory" Name="$(var.DesktopDirectoryName)" />
    </StandardDirectory>
    <StandardDirectory Id="System64Folder" />
    <StandardDirectory Id="ProgramMenuFolder" />
    <DirectoryRef Id="DesktopDirectory">
      <Component Id="MachineIdentity" Guid="*" Bitness="always64">
        <RemoveFolder Id="RemoveDesktopDirectory" On="uninstall" />
        <RegistryKey Root="HKLM" Key="$(var.InstalledProductRegistryPath)" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="$(var.TargetSidValueName)" Value="[TARGETSID]" Type="string" KeyPath="yes" />
          <RegistryValue Name="$(var.InstalledVersionValueName)" Value="$(var.FullVersion)" Type="string" />
          <RegistryValue Name="$(var.DeploymentKindValueName)" Value="MSI" Type="string" />
          <RegistryValue Name="$(var.MsiProductCodeValueName)" Value="[ProductCode]" Type="string" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
    <Icon Id="AppIcon.exe" SourceFile="$(var.MainAppSource)" />
    <Binary Id="NativeActions" SourceFile="$(var.ActionsPath)" />
    <CustomAction Id="ValidateDeployment" BinaryRef="NativeActions" DllEntry="ValidateDeployment" Execute="immediate" Return="check" />
    <CustomAction Id="PrepareDeployment" BinaryRef="NativeActions" DllEntry="PrepareDeployment" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="RollbackDeployment" BinaryRef="NativeActions" DllEntry="RollbackDeployment" Execute="rollback" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="ClearForRemoval" BinaryRef="NativeActions" DllEntry="ClearForRemoval" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="CompleteDeployment" BinaryRef="NativeActions" DllEntry="CompleteDeployment" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="CommitDeployment" BinaryRef="NativeActions" DllEntry="CommitDeployment" Execute="commit" Impersonate="no" Return="check" HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom Action="ValidateDeployment" Before="InstallInitialize" />
      <Custom Action="RollbackDeployment" After="InstallInitialize" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PrepareDeployment" After="RollbackDeployment" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ClearForRemoval" Before="StopServices" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="CompleteDeployment" After="RemoveExistingProducts" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CommitDeployment" Before="InstallFinalize" Condition="NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
